// Prisma schema — fonte única da verdade do banco.
// Dev: SQLite (zero config). Produção: troque provider para "postgresql".
//
// Convenção importante: TODO valor monetário é armazenado em CENTAVOS (Int).
// Nunca use Float para dinheiro — evita erros de arredondamento em checkout.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String? // emoji ou nome de ícone para UI
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String
  brand        String?
  priceCents   Int // preço de venda em centavos
  compareCents Int? // preço "de" (riscado) — para calcular desconto
  imageUrl     String
  gallery      String? // JSON string com URLs extras (SQLite não tem array)
  featured     Boolean             @default(false)
  active       Boolean             @default(true)
  stock        Int                 @default(0) // estoque quando não há variações
  weightGrams  Int                 @default(300)
  widthCm      Int                 @default(11)
  heightCm     Int                 @default(5)
  lengthCm     Int                 @default(16)
  category     Category            @relation(fields: [categoryId], references: [id])
  categoryId   String
  variants     Variant[]
  reviews      Review[]
  questions    Question[]
  auditEvents  ProductAuditEvent[]
  createdAt    DateTime            @default(now())

  @@index([categoryId])
  @@index([featured])
}

// Auditoria imutável do catálogo. Os dados do operador são snapshots para que o
// histórico continue legível mesmo se a conta da equipe for removida depois.
model ProductAuditEvent {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  action     String // CREATED | UPDATED
  changes    String // JSON: [{ field, label, before, after }]
  actorId    String?
  actorName  String?
  actorEmail String?
  actorRole  String?
  createdAt  DateTime @default(now())

  @@index([productId, createdAt])
}

// Variações (ex.: "128GB / Preto"). Preço/estoque podem sobrescrever o produto.
model Variant {
  id         String  @id @default(cuid())
  name       String
  sku        String  @unique
  priceCents Int? // se nulo, herda o preço do produto
  stock      Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String

  @@index([productId])
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  cpf                    String?   @unique // somente 11 dígitos; nullable para contas antigas/sociais
  phone                  String? // DDD + número, somente dígitos (10 ou 11)
  dateOfBirth            DateTime?
  gender                 String?
  referralSource         String?
  allowEmailUpdates      Boolean   @default(false)
  allowWhatsappUpdates   Boolean   @default(false)
  communicationConsentAt DateTime?
  name                   String?
  image                  String? // avatar (ex.: vindo do Google)
  passwordHash           String? // hash Argon2/bcrypt — nulo para contas só-social
  role                   String    @default("CLIENTE") // CLIENTE | VENDEDOR | GERENTE | ADMIN
  emailVerified          DateTime?
  createdAt              DateTime  @default(now())
  lastLoginAt            DateTime? // atualizado no evento signIn (src/auth.ts) — último login, não navegação em tempo real

  orders              Order[]
  reviews             Review[]
  questions           Question[]
  addresses           Address[]
  accounts            Account[] // logins sociais vinculados
  sessions            Session[]
  orderMessages       OrderMessage[]
  returnRequests      ReturnRequest[]
  passwordResetTokens PasswordResetToken[]
  chatSessions        ChatSession[]
  orderFeedbacks      OrderFeedback[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Web analytics first-party, coletado somente após consentimento. Não armazena IP
// nem dados pessoais; visitorId/sessionId são identificadores aleatórios anônimos.
model WebsiteVisit {
  id           String    @id
  visitorId    String
  sessionId    String
  path         String
  productId    String?
  productName  String?
  referrerHost String?
  utmSource    String?
  device       String
  browser      String
  durationMs   Int       @default(0)
  startedAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  endedAt      DateTime?

  @@index([startedAt])
  @@index([path, startedAt])
  @@index([productId, startedAt])
  @@index([visitorId, startedAt])
  @@index([sessionId, startedAt])
  @@index([lastSeenAt])
}

// Endereços salvos do cliente — só pra usuários logados (checkout de convidado
// nunca grava aqui). Um cliente pode ter vários (Casa, Trabalho...), um padrão.
model Address {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  label        String // rótulo livre: "Casa", "Trabalho"
  name         String // destinatário (pode diferir do nome da conta)
  cep          String // 8 dígitos, sem máscara
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String // UF, 2 letras
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// --- Modelos padrão do Auth.js (NextAuth) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id             String             @id @default(cuid())
  email          String
  totalCents     Int
  // Status: AGUARDANDO_PAGAMENTO | PAGAMENTO_RECUSADO | PAGAMENTO_APROVADO | PREPARANDO_ENVIO | ENVIADO | ENTREGUE | REEMBOLSO_SOLICITADO | REEMBOLSADO | CANCELADO
  status         String             @default("AGUARDANDO_PAGAMENTO")
  user           User?              @relation(fields: [userId], references: [id])
  userId         String?
  items          OrderItem[]
  statusEvents   OrderStatusEvent[]
  messages       OrderMessage[]
  returnRequests ReturnRequest[]
  feedback       OrderFeedback?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // --- Rastreamento de Cancelamento/Reembolso ---
  reasonCancelled   String? // motivo do cancelamento (ex: "Cliente desistiu", "Recusa de pagamento")
  refundReason      String? // motivo do reembolso (ex: "Produto danificado", "Não chegou")
  refundRequestedAt DateTime? // timestamp da solicitação de reembolso
  canChangeAddress  Boolean   @default(true) // permite mudar endereço antes do envio

  // --- Timeout para pedidos abandonados ---
  // Orders AGUARDANDO_PAGAMENTO > 30 min podem ser auto-canceladas
  abandonedAt DateTime? // marca quando o pedido foi identificado como abandonado

  // Estoque disponível é debitado ao criar o pedido. A reserva vira consumo
  // definitivo na aprovação ou é devolvida ao cancelar/expirar.
  stockReservationStatus    String    @default("NONE") // NONE | RESERVED | CONSUMED | RELEASED
  stockReservedAt           DateTime?
  stockReservationExpiresAt DateTime?
  stockReleasedAt           DateTime?

  // --- Mercado Pago (Checkout Pro) ---
  mpPreferenceId  String? @unique // Preference criada ao iniciar o checkout
  mpPaymentId     String? @unique // setado pelo webhook quando a MP confirma o pagamento
  mpPaymentMethod String? // payment_type_id da MP: pix, credit_card, ticket...
  mpStatusDetail  String? // status_detail bruto da MP (debug de recusas)
  paymentChoice   String? // PIX | CARD_BOLETO — opção escolhida antes do Checkout Pro
  discountCents   Int     @default(0) // desconto efetivamente aplicado aos produtos

  // --- Endereço de entrega (snapshot no momento da compra) ---
  // Nullable: pedidos antigos (antes desta feature) não têm esses dados; todo
  // pedido novo sempre preenche. Páginas de detalhe tratam shippingCents==null
  // como "pedido legado" e escondem a seção de frete/endereço.
  shipName         String?
  shipPhone        String?
  shipDocument     String?
  shipCep          String?
  shipStreet       String?
  shipNumber       String?
  shipComplement   String?
  shipNeighborhood String?
  shipCity         String?
  shipState        String?

  // --- Frete ---
  shippingCents            Int? // valor efetivamente cobrado (0 = grátis; null = pedido legado)
  shippingMethod           String? // rótulo da opção escolhida, ex.: "Econômico — 2 a 4 dias úteis"
  shippingProvider         String?
  shippingServiceId        String?
  melhorEnvioOrderId       String?         @unique
  shippingLabelStatus      String? // CART | PURCHASED | GENERATED | POSTED | DELIVERED | ISSUE | CANCELLED
  shippingLabelUrl         String?
  shippingLabelCostCents   Int?
  shippingInvoiceKey       String?
  shippingLabelError       String?
  shippingLabelPurchasedAt DateTime?
  shippingLabelGeneratedAt DateTime?
  shippingLastSyncAt       DateTime?
  shippingNeedsAttention   Boolean         @default(false)
  shippingEvents           ShippingEvent[]
  refundedCents            Int             @default(0)

  // --- Rastreamento de envio ---
  // Sem integração com API de transportadora — o vendedor cola o código/link que
  // recebeu. Se só o código vier e bater com o padrão dos Correios, a tela monta
  // o link público sozinha (ver resolveTrackingUrl em lib/orders.ts).
  trackingCode String?
  trackingUrl  String?

  // --- Chat do pedido ---
  // Quem deve responder agora: "STAFF" (cliente mandou última msg, equipe deve
  // responder) ou "CLIENTE" (equipe respondeu, aguardando cliente). Null = sem
  // mensagens ainda. Atualizado a cada OrderMessage criada.
  awaitingReplyFrom String?
  // Timestamp da mensagem que colocou o chat em "aguardando cliente" — usado só
  // pra contar os 3 dias de inatividade (closeStaleChats). Nunca conta enquanto
  // awaitingReplyFrom == "STAFF" (não faz sentido cobrar prazo da equipe assim).
  chatWaitingSince  DateTime?
  // Fechamento manual (staff) ou automático (3 dias sem resposta do cliente).
  // Uma nova mensagem de qualquer lado reabre automaticamente (limpa este campo).
  chatClosedAt      DateTime?

  @@index([email])
  @@index([status])
  @@index([userId])
  @@index([abandonedAt])
  @@index([stockReservationStatus, stockReservationExpiresAt])
}

model OrderFeedback {
  id             String   @id @default(cuid())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  deliveryRating Int
  serviceRating  Int
  sellerRating   Int
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([createdAt])
}

model ShippingEvent {
  id               String   @id @default(cuid())
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  provider         String   @default("MELHOR_ENVIO")
  providerEvent    String
  providerStatus   String?
  title            String
  description      String?
  trackingCode     String?
  trackingUrl      String?
  needsAttention   Boolean  @default(false)
  externalEventKey String   @unique
  occurredAt       DateTime
  createdAt        DateTime @default(now())

  @@index([orderId, occurredAt])
  @@index([needsAttention, createdAt])
}

model IntegrationCredential {
  id                    String   @id @default(cuid())
  provider              String   @unique
  encryptedAccessToken  String
  encryptedRefreshToken String?
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OrderItem {
  id                String       @id @default(cuid())
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  productId         String
  productName       String // snapshot: nome no momento da compra
  variantName       String?
  variantId         String? // snapshot técnico para movimentar o estoque sem depender do nome
  unitCents         Int // preço unitário no momento da compra
  originalUnitCents Int? // preço antes do desconto; null apenas em pedidos legados
  qty               Int
  returnItems       ReturnItem[]

  @@index([orderId])
}

// Devoluções possuem ciclo de vida próprio: uma devolução parcial não altera o
// estado logístico do pedido inteiro. Valores continuam sempre em centavos.
model ReturnRequest {
  id                  String        @id @default(cuid())
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId             String
  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId              String
  status              String        @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | AWAITING_SHIPMENT | IN_TRANSIT | RECEIVED | INSPECTED | REFUND_PROCESSING | REFUNDED | REFUND_FAILED | CANCELLED
  requestType         String        @default("RETURN") // CANCELLATION (antes do envio) | RETURN (após envio)
  reasonCategory      String
  reasonDetails       String
  evidenceUrls        String? // JSON string de URLs públicas
  customerNote        String?
  staffNote           String?
  rejectionReason     String?
  reverseInstructions String?
  reverseTrackingCode String?
  reverseTrackingUrl  String?
  reverseLabelUrl     String?
  requestedCents      Int
  approvedCents       Int?
  includeShipping     Boolean       @default(false)
  mpRefundId          String?       @unique
  idempotencyKey      String        @unique
  refundError         String?
  reviewedById        String?
  reviewedByName      String?
  requestedAt         DateTime      @default(now())
  reviewedAt          DateTime?
  shippedAt           DateTime?
  receivedAt          DateTime?
  inspectedAt         DateTime?
  refundedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  items               ReturnItem[]
  events              ReturnEvent[]

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnRequestId String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  orderItemId     String
  qty             Int
  unitCents       Int
  condition       String? // SEALED | SELLABLE | DAMAGED | INCOMPLETE | MISSING
  restockDecision String        @default("PENDING") // PENDING | RESTOCK | DO_NOT_RESTOCK
  restockedAt     DateTime?

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ReturnEvent {
  id              String        @id @default(cuid())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnRequestId String
  status          String
  note            String?
  actorId         String?
  actorName       String?
  actorRole       String?
  createdAt       DateTime      @default(now())

  @@index([returnRequestId, createdAt])
}

// Linha do tempo do pedido — um snapshot por mudança de status. Alimentado pela
// criação (PENDENTE), pelo webhook da MP (PAGO/CANCELADO) e pelas atualizações
// manuais do staff no painel (ENVIADO/ENTREGUE/...).
model OrderStatusEvent {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String // snapshot do status nesse momento
  note      String? // opcional: código de rastreio, motivo, observação do staff
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderMessage {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  senderRole String // CLIENTE | VENDEDOR | GERENTE | ADMIN
  text       String
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([userId])
}

// Chat do widget flutuante da loja — pré-venda/institucional, sem Order associado
// (diferente de OrderMessage, que só existe depois de um pedido). Anônimo por padrão
// (visitorId do localStorage, mesma técnica do WebsiteVisit); linka userId quando a
// pessoa está logada. Só existe a partir do momento em que a pessoa pede pra falar
// com um atendente — a conversa com o bot em si não é gravada (roda só no client).
model ChatSession {
  id                String        @id @default(cuid())
  visitorId         String // id anônimo gerado no client (localStorage)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?
  name              String?
  email             String
  reason            String // motivo escolhido no miniform (texto livre, como Order.status)
  orderRef          String? // nº de pedido informado pela pessoa; não é FK
  awaitingReplyFrom String? // STAFF | VISITANTE
  chatWaitingSince  DateTime?
  chatClosedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  messages          ChatMessage[]

  @@index([visitorId])
  @@index([awaitingReplyFrom])
}

model ChatMessage {
  id         String      @id @default(cuid())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  senderRole String // VISITANTE | VENDEDOR | GERENTE | ADMIN
  text       String
  createdAt  DateTime    @default(now())

  @@index([sessionId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1 a 5
  comment   String?
  hidden    Boolean  @default(false) // moderação: oculta da loja sem apagar o dado
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId]) // 1 avaliação definitiva por cliente/produto
  @@index([productId])
}

model Question {
  id         String    @id @default(cuid())
  question   String
  answer     String?
  answeredBy String? // snapshot do nome/e-mail de quem respondeu — não é relation
  answeredAt DateTime?
  hidden     Boolean   @default(false)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime  @default(now())

  @@index([productId])
}
