# --- Banco de dados ---
# SQLite para desenvolvimento (roda na hora)
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL): DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Autenticação (Auth.js) ---
# Gere um segredo forte com:  npx auth secret
AUTH_SECRET="troque-por-um-segredo-forte-gerado-com-npx-auth-secret"

# Login com Google (opcional). Se deixar vazio, o botão do Google não aparece.
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ==========================================
#  Mercado Pago — Checkout Pro (AMBIENTE DE TESTE)
# ==========================================

# Access Token de TESTE — chave PRIVADA, usada só no backend.
# NUNCA compartilhe, nunca suba pro Git. Cole aqui o "Test Access Token".
MP_ACCESS_TOKEN=""

# Public Key de TESTE — pode aparecer no frontend.
# No Checkout Pro é opcional; útil se um dia migrar para Checkout Transparente.
MP_PUBLIC_KEY=""

# Segredo do webhook — valida que a notificação veio mesmo do Mercado Pago.
# Você gera/copia isso ao configurar o webhook no painel do MP.
MP_WEBHOOK_SECRET=""

# URL base da aplicação — usada nas telas de retorno (sucesso/erro) e no webhook.
# Em dev local: http://localhost:3000
# Ao testar webhook, troque pela URL do túnel (ex.: ngrok): https://xxxx.ngrok-free.app
APP_URL="http://localhost:3000"

# --- E-mails transacionais (Brevo) ---
# Gere a chave em Brevo > SMTP e API > Chaves de API. Nunca exponha no navegador.
BREVO_API_KEY=""
# Use exatamente o remetente que você confirmou dentro da Brevo.
EMAIL_FROM="Heca Store <caik.job1707@gmail.com>"
# Também envia recuperação de senha, pagamento, entrega e reembolso.

# --- Anexos do chat (Vercel Blob) ---
# Criado automaticamente ao conectar um Blob Store público ao projeto na Vercel.
# Necessário para imagens no chat dos pedidos.
BLOB_READ_WRITE_TOKEN=""

# --- Melhor Envio ---
MELHOR_ENVIO_SANDBOX="true"
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
MELHOR_ENVIO_REDIRECT_URI="http://localhost:3000/api/integracoes/melhor-envio/callback"
MELHOR_ENVIO_USER_AGENT="Heca - Store (contato@seudominio.com.br)"
MELHOR_ENVIO_ORIGIN_CEP=""

# Remetente usado na compra das etiquetas. Informe CPF OU CNPJ, nunca ambos.
MELHOR_ENVIO_SENDER_NAME=""
MELHOR_ENVIO_SENDER_EMAIL=""
MELHOR_ENVIO_SENDER_PHONE=""
MELHOR_ENVIO_SENDER_DOCUMENT=""
MELHOR_ENVIO_SENDER_COMPANY_DOCUMENT=""
MELHOR_ENVIO_SENDER_STATE_REGISTER=""
MELHOR_ENVIO_SENDER_ADDRESS=""
MELHOR_ENVIO_SENDER_NUMBER=""
MELHOR_ENVIO_SENDER_COMPLEMENT=""
MELHOR_ENVIO_SENDER_DISTRICT=""
MELHOR_ENVIO_SENDER_CITY=""
MELHOR_ENVIO_SENDER_STATE=""

# --- Quando for para produção, troque por: ---
# MP_ACCESS_TOKEN="APP_USR-..."   (Access Token de produção)
# MP_PUBLIC_KEY="APP_USR-..."
# APP_URL="https://seudominio.com.br"
